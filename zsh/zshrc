# omacosy zsh — the CLI-stack wiring. Personal config belongs in
# ~/.zshrc.local (sourced below), so this file stays generic.

# Homebrew env. .zprofile already exports it for login shells; only fill in for
# non-login interactive shells. `brew shellenv` shells out to /bin/ps, which the
# Codex sandbox blocks, so this stays a static export instead of an eval.
if [ -z "$HOMEBREW_PREFIX" ] && [ -x /opt/homebrew/bin/brew ]; then
  export HOMEBREW_PREFIX="/opt/homebrew" HOMEBREW_CELLAR="/opt/homebrew/Cellar" HOMEBREW_REPOSITORY="/opt/homebrew"
  export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
  fpath[1,0]="/opt/homebrew/share/zsh/site-functions"
fi

export PATH="$HOME/.local/bin:$PATH"

# omacosy repo location, derived from the installed theme-set symlink
if [ -L "$HOME/.local/bin/theme-set" ]; then
  export OMACOSY="$(dirname "$(dirname "$(readlink -f "$HOME/.local/bin/theme-set")")")"
fi

autoload -Uz compinit
for dump in ~/.zcompdump(N.mh+24); do
  compinit -u
done
compinit -C

# everything personal lives here; keep this file distributable
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

# CLI stack (after .zshrc.local so frameworks there can't clobber these)
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
command -v fzf >/dev/null && source <(fzf --zsh)

alias ls='eza --group-directories-first --icons=auto'
alias ll='eza -lh --group-directories-first --icons=auto'
alias la='eza -lah --group-directories-first --icons=auto'
alias lt='eza --tree --level=2 --icons=auto'
alias cat='bat --paging=never'
alias lg='lazygit'
